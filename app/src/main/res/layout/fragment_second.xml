<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textview_active_player_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Player 1" />

            <TextView
                android:id="@+id/textview_current_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="64sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textview_active_player_name"
                tools:text="501" />

            <!-- Throw 1 -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_throw_type_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/layout_throw_1"
                app:singleSelection="true">

                <Button
                    android:id="@+id/button_double_1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/double_label" />

                <Button
                    android:id="@+id/button_triple_1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/triple_label" />

                <Button
                    android:id="@+id/button_strike_1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/single_label" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_throw_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/throw_hint1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/toggle_group_throw_type_1"
                app:layout_constraintTop_toBottomOf="@id/textview_current_score">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_throw_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Throw 2 -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_throw_type_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/layout_throw_2"
                app:singleSelection="true">

                <Button
                    android:id="@+id/button_double_2"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/double_label" />

                <Button
                    android:id="@+id/button_triple_2"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/triple_label" />

                <Button
                    android:id="@+id/button_strike_2"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/single_label" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_throw_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:hint="@string/throw_hint2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/toggle_group_throw_type_2"
                app:layout_constraintTop_toBottomOf="@id/layout_throw_1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_throw_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Throw 3 -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_throw_type_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/layout_throw_3"
                app:singleSelection="true">

                <Button
                    android:id="@+id/button_double_3"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/double_label" />

                <Button
                    android:id="@+id/button_triple_3"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/triple_label" />

                <Button
                    android:id="@+id/button_strike_3"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/single_label" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_throw_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:hint="@string/throw_hint3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/toggle_group_throw_type_3"
                app:layout_constraintTop_toBottomOf="@id/layout_throw_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_throw_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/button_submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:text="@string/submit"
                app:layout_constraintEnd_toEndOf="@id/toggle_group_throw_type_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_throw_3" />

            <TextView
                android:id="@+id/textview_round_total_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/button_submit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/button_submit"
                tools:text="0" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/players_table_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/button_submit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TableLayout
                    android:id="@+id/table_players_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:stretchColumns="0,1,2,3">

                    <TableRow
                        android:id="@+id/table_header"
                        android:background="?attr/colorSecondaryContainer">
                        <TextView
                            android:id="@+id/header_player"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            tools:text="First to 5" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/sets_label"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/legs_label_table"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/score_label"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </TableRow>
                </TableLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
